---
import Navbar from "@components/contents/Navbar/Navbar.astro";
import Footer from "@components/contents/Footer/Footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Container from "@components/wrappers/Container.astro";
import BackgroundGradient from "@components/ui/BackgroundGradient.astro";
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <link
            rel="preload"
            href="/fonts/Doto-VariableFont_ROND,wght.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <meta name="generator" content={Astro.generator} />
        <title>CSAP</title>
    </head>
    <body
        class="text-foreground font-sans min-h-screen flex flex-col overflow-x-hidden"
    >
        <ClientRouter />
        <BackgroundGradient />
        <Navbar />
        <main class="flex w-full h-full flex-col min-h-screen relative z-10">
            <Container>
                <slot />
            </Container>
        </main>
        <Footer />
    </body>
</html>
