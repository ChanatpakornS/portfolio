---
import { Name } from "@components/contents/Name/Name.tsx";
import Layout from "@layouts/Layout.astro";
import { resume } from "@components/contents/Resume/data/resume";
---

<Layout>
    <!-- Hero -->
    <section
        class="min-h-[85vh] flex flex-col items-center justify-center text-center px-4 py-20 relative"
    >
        <p
            class="hero-greeting text-base md:text-lg text-gray-500 mb-4 tracking-[0.25em] uppercase font-normal"
        >
            Hello, I'm
        </p>
        <div class="hero-name">
            <Name client:load />
        </div>
        <p class="hero-subtitle text-lg md:text-xl mt-6 text-gray-600 font-normal">
            Software Engineer · Bangkok, Thailand
        </p>
        <p
            class="hero-description mt-6 max-w-lg text-gray-500 font-normal leading-relaxed text-sm md:text-base"
        >
            <span class="italic" style="font-family: 'Times New Roman', Times, serif; font-weight: normal;">"A visionary digital craftsman, passionately architecting the backend systems of tomorrow whilst pursuing the noble art of Computer Engineering at the prestigious Chulalongkorn University. His scalable distributed architectures shall echo through the annals of cyberspace for generations to come."</span>
            <span class="block mt-2 text-gray-400 text-xs md:text-sm" style="font-family: 'Times New Roman', Times, serif; font-weight: normal; font-style: italic;">— Claude.ai, 2026</span>
        </p>
        <div class="hero-buttons flex flex-wrap gap-3 mt-10 justify-center">
            <a
                href="/resume"
                data-astro-reload
                class="bg-spotlight text-white px-6 py-3 rounded-full hover:scale-105 transition-transform font-bold text-sm"
            >
                View Resume
            </a>
            <a
                href="https://github.com/ChanatpakornS"
                target="_blank"
                rel="noreferrer"
                class="border-2 border-gray-800 text-gray-800 px-6 py-3 rounded-full hover:bg-gray-800 hover:text-white transition-all font-bold text-sm"
            >
                GitHub
            </a>
            <a
                href="https://th.linkedin.com/in/chanatpakorn-sirintronsopon-85156227a"
                target="_blank"
                rel="noreferrer"
                class="border-2 border-gray-800 text-gray-800 px-6 py-3 rounded-full hover:bg-gray-800 hover:text-white transition-all font-bold text-sm"
            >
                LinkedIn
            </a>
        </div>
    </section>
</Layout>

<script>
    import { createTimeline } from "animejs";

    const animated = ".hero-greeting, .hero-name, .hero-subtitle, .hero-description, .hero-buttons";
    let firstLoad = true;

    function initAnimations() {
        if (!document.querySelector(".hero-greeting")) return;

        if (!firstLoad) return;
        firstLoad = false;

        document.querySelectorAll(animated).forEach((el) => {
            (el as HTMLElement).style.opacity = "0";
        });

        const heroTl = createTimeline({
            defaults: { duration: 800, ease: "outQuint" },
        });

        heroTl
            .add(".hero-greeting", {
                opacity: [0, 1],
                translateY: [30, 0],
            }, 200)
            .add(".hero-name", {
                opacity: [0, 1],
                scale: [0.92, 1],
            }, 400)
            .add(".hero-subtitle", {
                opacity: [0, 1],
                translateY: [20, 0],
            }, 800)
            .add(".hero-description", {
                opacity: [0, 1],
                translateY: [20, 0],
            }, 1100)
            .add(".hero-buttons", {
                opacity: [0, 1],
                translateY: [20, 0],
            }, 1400);
    }

    document.addEventListener("astro:page-load", initAnimations);
</script>
